# Core stack config (traefik + watchtower). Copy to `.env` and fill in.
# This file must live next to docker-compose.yml so `docker compose` auto-loads it.

# Base domain for all apps. Point a wildcard DNS record (*.DOMAIN) at the
# Lightsail static IP so new subdomains never need a DNS change.
DOMAIN=rwcoder.com

# Email used for Let's Encrypt certificate registration/expiry notices.
ACME_EMAIL=ramvlay@gmail.com

# ACME directory URL. Leave commented for real (production) certificates.
#
# Let's Encrypt production enforces hard rate limits — notably 5 failed
# validations per account/hostname/hour. Misconfigured DNS or a closed port 80
# burns through that in minutes and then locks you out for an hour, mid-setup.
# Uncomment this to validate against staging first (certs will be untrusted in
# the browser — that's expected); once the cert issues cleanly, comment it out
# and `docker compose up -d --force-recreate traefik` to get a trusted one.
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Traefik dashboard basic-auth credentials live in traefik/dashboard-users.htpasswd
# (NOT here) — a bcrypt hash is full of '$' characters, which docker compose's
# .env variable interpolation mangles. See traefik/dashboard-users.htpasswd.example.

# Traefik log verbosity: DEBUG | INFO | WARN | ERROR
TRAEFIK_LOG_LEVEL=INFO

# Timezone used for log timestamps / watchtower scheduling.
TZ=America/Bogota

# How often (seconds) Watchtower checks for new image digests. 3600 (hourly)
# is plenty for personal apps and avoids hammering GHCR / waking the CPU every
# few minutes. Drop it (e.g. 300) only if you want near-immediate rollouts.
WATCHTOWER_POLL_INTERVAL=3600

# Optional: shoutrrr notification URL for Watchtower update events, e.g.
# a Discord/Telegram/Slack webhook. Leave empty to disable notifications.
# See: https://nicholas-fedor.github.io/watchtower/notifications/
WATCHTOWER_NOTIFICATION_URL=
