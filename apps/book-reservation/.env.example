# book-reservation app config. Copy to `.env` in this same folder.

# Must match the root .env's DOMAIN (app is served at books.${DOMAIN}).
DOMAIN=example.com

# Image tag to run. Use `:latest` to let Watchtower auto-update on every
# push to master, or pin an immutable `:vX.Y.Z` release tag to opt out of
# auto-updates until you bump this manually.
BOOK_RESERVATION_IMAGE=ghcr.io/vladimirvaca/book_reservation:latest

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
BOOK_RESERVATION_SECRET_KEY=changeme-generate-a-real-secret
