# Config for the `my-app` stack. Copy to `.env` in this same folder.
# Every variable the compose file reads must be documented here — this file is
# committed, `.env` never is.

# Must match the root .env's DOMAIN. Duplicated by design: each `docker compose`
# invocation only auto-loads the .env sitting next to the file it was given.
DOMAIN=example.com

# Image to run. `:latest` lets Watchtower auto-update on every push; pinning an
# immutable `:vX.Y.Z` tag opts this app out until you bump it by hand.
MYAPP_IMAGE=ghcr.io/vladimirvaca/my-app:latest

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
MYAPP_SECRET_KEY=changeme-generate-a-real-secret
